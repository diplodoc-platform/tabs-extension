{
  "name": "@diplodoc/tabs-extension",
  "version": "3.10.8-transform5.3",
  "description": "Tabs plugin for Diplodoc transformer and builder",
  "main": "build/plugin/index.js",
  "types": "build/plugin/index.d.ts",
  "engines": {
    "node": ">=24",
    "npm": ">=11.5.1"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:diplodoc-platform/tabs-extension.git"
  },
  "exports": {
    ".": {
      "types": "./build/plugin/index.d.ts",
      "node": "./build/plugin/index-node.js",
      "default": "./build/plugin/index.js"
    },
    "./runtime": {
      "types": "./build/runtime/index.d.ts",
      "style": "./build/runtime/index.css",
      "default": "./build/runtime/index.js"
    },
    "./runtime/styles": "./build/runtime/index.css",
    "./runtime/styles.css": "./build/runtime/index.css",
    "./react": {
      "types": "./build/react/index.d.ts",
      "default": "./build/react/index.js"
    }
  },
  "scripts": {
    "build": "run-p build:*",
    "build:js": "node ./esbuild/build.mjs",
    "build:declarations": "tsc --emitDeclarationOnly --outDir ./build -p tsconfig.publish.json && node scripts/fix-runtime-declarations.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "lint",
    "lint:fix": "lint fix",
    "pre-commit": "lint-staged",
    "prepare": "husky || true",
    "lock": "npm install --no-workspaces --package-lock-only --ignore-scripts",
    "test:package": "node test/compat/run.mjs"
  },
  "author": "",
  "license": "MIT",
  "files": [
    "build"
  ],
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@diplodoc/infra": "2.3.0",
    "@types/github-slugger": "^1.3.0",
    "@types/markdown-it": "^13.0.9",
    "@types/node": "*",
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^3.2.4",
    "github-slugger": "^1.5.0",
    "jsdom": "20.0.3",
    "markdown-it": "^13.0.2",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-transform15": "npm:markdown-it@15.0.3",
    "npm-run-all": "^4.1.5",
    "slugify": "1.6.6",
    "ts-dedent": "^2.2.0",
    "typescript": "6.0.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@diplodoc/directive": "0.5.0-transform5.2",
    "@diplodoc/utils": "2.3.7-transform5.0"
  },
  "overrides": {
    "markdown-it": {
      "linkify-it": "5.0.2"
    }
  }
}
